page {
  --bg-canvas: #F6F1E7;
  --bg-surface: #FFFDF8;
  --bg-elevated: #FFFFFC;
  --bg-sunken: #EEE7DC;
  --text-primary: #282421;
  --text-secondary: #6D6258;
  --text-tertiary: #756A60;
  --brand-primary: #B94738;
  --brand-pressed: #96372B;
  --brand-soft: #F2D9D1;
  --accent-memory: #8B5F12;
  --accent-soft: #F3E5C5;
  --border-subtle: #D6CBBC;
  --border-strong: #9D9183;
  background: var(--bg-canvas);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", sans-serif;
  font-size: 30rpx;
}

view,
text,
image,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: 1;
}

button::after {
  border: 0;
}

.page-scroll {
  height: 100vh;
  background: var(--bg-canvas);
}

.screen {
  min-height: 100%;
  padding: calc(env(safe-area-inset-top) + 78rpx) 32rpx 80rpx;
}

.brand-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.wordmark {
  display: block;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 82rpx;
  font-weight: 700;
  line-height: 0.92;
  letter-spacing: -4rpx;
}

.brand-subtitle {
  display: block;
  margin-top: 16rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  letter-spacing: 8rpx;
}

.content-action {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  min-width: 82rpx;
  max-width: 82rpx;
  flex: 0 0 82rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border-strong);
  border-radius: 50%;
  background: var(--bg-surface);
  color: var(--brand-primary);
  font-size: 46rpx;
  font-weight: 300;
  box-shadow: 0 12rpx 30rpx rgba(80, 61, 40, 0.08);
}

.content-action--pressed {
  border-color: var(--brand-primary);
  background: var(--brand-soft);
}

.page-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.eyebrow {
  color: var(--accent-memory);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
  text-transform: uppercase;
}

.page-title {
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 68rpx;
  font-weight: 600;
  line-height: 1.12;
}

.page-description {
  margin-top: 18rpx;
  color: var(--text-secondary);
  font-size: 29rpx;
  line-height: 1.65;
}

.section-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 44rpx 0 22rpx;
}

.section-heading__title {
  font-family: "Songti SC", "STSong", serif;
  font-size: 36rpx;
  font-weight: 600;
}

.section-heading__meta {
  color: var(--text-tertiary);
  font-size: 24rpx;
}

.paper-card {
  border: 1rpx solid var(--border-subtle);
  border-radius: 30rpx;
  background: var(--bg-surface);
  box-shadow: 0 18rpx 46rpx rgba(80, 61, 40, 0.08);
}

.tag {
  display: inline-flex;
  min-height: 52rpx;
  align-items: center;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--bg-sunken);
  color: var(--text-secondary);
  font-size: 23rpx;
}

.tag--active {
  background: var(--brand-soft);
  color: #8F3329;
  font-weight: 600;
}

.primary-button {
  display: flex;
  width: 100%;
  min-height: 100rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--brand-primary);
  color: #FFF8F0;
  font-size: 32rpx;
  font-weight: 600;
}

.primary-button--disabled {
  opacity: 0.58;
}

.primary-button--pressed {
  background: var(--brand-pressed);
}

.secondary-button {
  display: flex;
  width: 100%;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border-strong);
  border-radius: 999rpx;
  background: var(--bg-surface);
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.secondary-button--pressed {
  border-color: var(--brand-primary);
  background: var(--brand-soft);
}

.back-button {
  display: flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border-subtle);
  border-radius: 50%;
  background: var(--bg-surface);
  font-size: 42rpx;
}

.empty-state {
  padding: 76rpx 42rpx;
  border: 2rpx dashed var(--border-subtle);
  border-radius: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.65;
}
