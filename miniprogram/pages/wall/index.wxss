.wall-screen {
  padding-bottom: 180rpx;
}

.wall-brand-header {
  margin-bottom: 42rpx;
}

.filter-scroll {
  width: calc(100% + 72rpx);
  margin: 34rpx -36rpx 26rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: 14rpx;
  padding: 0 36rpx 10rpx;
}

.filter-chip {
  display: inline-flex;
  min-height: 64rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  padding: 0 26rpx;
  border: 1rpx solid var(--border-subtle);
  border-radius: 999rpx;
  background: var(--bg-surface);
  color: var(--text-secondary);
  font-size: 25rpx;
  line-height: 1;
}

.filter-chip--active {
  border-color: var(--brand-primary);
  background: var(--brand-primary);
  color: #FFF8F0;
  font-weight: 600;
}

.wall-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.wall-card {
  overflow: hidden;
}

.wall-image,
.wall-placeholder {
  display: flex;
  width: 100%;
  height: 300rpx;
  align-items: center;
  justify-content: center;
  background: var(--bg-sunken);
}

.wall-placeholder {
  color: var(--accent-memory);
  font-family: "Songti SC", serif;
  font-size: 78rpx;
}

.wall-copy {
  padding: 22rpx;
}

.wall-date {
  color: var(--brand-primary);
  font-size: 18rpx;
  font-weight: 600;
}

.wall-title {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
