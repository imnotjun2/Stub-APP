.trip-detail-screen {
  padding-bottom: 120rpx;
}

.trip-detail-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.nav-spacer {
  width: 80rpx;
}

.trip-hero {
  display: block;
  width: 100%;
  height: 460rpx;
  border-radius: 30rpx;
  box-shadow: 0 18rpx 46rpx rgba(80, 61, 40, 0.1);
}

.trip-intro {
  position: relative;
  z-index: 2;
  margin: -50rpx 26rpx 0;
  padding: 34rpx;
}

.trip-date,
.trip-title,
.trip-route,
.trip-note {
  display: block;
}

.trip-date {
  color: var(--brand-primary);
  font-size: 21rpx;
  font-weight: 700;
}

.trip-title {
  margin-top: 14rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 600;
}

.trip-route {
  margin-top: 14rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.trip-note {
  margin-top: 20rpx;
  color: var(--accent-memory);
  font-family: "Songti SC", "STSong", serif;
  font-size: 27rpx;
}

.trip-timeline {
  position: relative;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.day-marker {
  display: flex;
  width: 76rpx;
  flex: 0 0 76rpx;
  flex-direction: column;
  align-items: center;
  padding-top: 18rpx;
}

.day-label {
  color: var(--text-tertiary);
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.day-number {
  margin-top: 3rpx;
  color: var(--accent-memory);
  font-family: Georgia, serif;
  font-size: 38rpx;
  font-weight: 700;
}

.timeline-card {
  min-width: 0;
  flex: 1;
  overflow: hidden;
}

.timeline-image {
  display: block;
  width: 100%;
  height: 250rpx;
}

.timeline-copy {
  padding: 26rpx;
}

.timeline-date {
  color: var(--brand-primary);
  font-size: 20rpx;
  font-weight: 600;
}

.timeline-title {
  display: block;
  margin-top: 10rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.45;
}

.timeline-note {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.primary-button {
  margin-top: 40rpx;
}
