.trips-screen {
  padding-bottom: 180rpx;
}

.trips-brand-header {
  margin-bottom: 42rpx;
}

.map-card {
  position: relative;
  overflow: hidden;
  margin-top: 34rpx;
}

.map-image {
  display: block;
  width: 100%;
  height: 420rpx;
}

.route-pill {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  max-width: calc(100% - 48rpx);
  padding: 14rpx 22rpx;
  border: 1rpx solid rgba(157, 145, 131, 0.8);
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.92);
  color: var(--text-secondary);
  font-size: 21rpx;
}

.map-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 30rpx;
}

.map-kicker,
.map-title,
.map-note {
  display: block;
}

.map-kicker {
  color: var(--brand-primary);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.map-title {
  margin-top: 10rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 36rpx;
  font-weight: 600;
}

.map-note {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
}

.map-count {
  display: flex;
  min-width: 110rpx;
  flex-direction: column;
  align-items: center;
  padding-left: 22rpx;
  border-left: 1rpx solid var(--border-subtle);
}

.map-count-number {
  color: var(--accent-memory);
  font-family: Georgia, serif;
  font-size: 48rpx;
  font-weight: 700;
}

.map-count-label {
  margin-top: 4rpx;
  color: var(--text-tertiary);
  font-size: 20rpx;
}

.book-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.book-card {
  display: flex;
  min-height: 230rpx;
  overflow: hidden;
}

.book-cover {
  width: 230rpx;
  min-height: 230rpx;
}

.book-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  padding: 26rpx;
}

.book-kicker {
  color: var(--accent-memory);
  font-family: Georgia, serif;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.book-title {
  margin-top: 13rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 600;
}

.book-route {
  overflow: hidden;
  margin-top: 10rpx;
  color: var(--text-secondary);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-link {
  margin-top: 20rpx;
  color: var(--brand-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.trip-tip {
  margin-top: 34rpx;
  padding: 26rpx;
  border-radius: 22rpx;
  background: var(--accent-soft);
  color: var(--accent-memory);
  font-size: 23rpx;
  line-height: 1.6;
}
