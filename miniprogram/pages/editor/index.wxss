.editor-screen {
  padding-bottom: 120rpx;
}

.editor-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 34rpx;
}

.editor-heading {
  text-align: center;
}

.editor-title {
  display: block;
  margin-top: 8rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
  font-weight: 600;
}

.nav-spacer {
  width: 80rpx;
}

.upload-card {
  overflow: hidden;
}

.upload-empty {
  display: flex;
  width: 100%;
  min-height: 420rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 44rpx;
}

.upload-plus {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--border-strong);
  border-radius: 50%;
  color: var(--brand-primary);
  font-size: 64rpx;
  font-weight: 300;
}

.upload-title {
  margin-top: 30rpx;
  font-family: "Songti SC", "STSong", serif;
  font-size: 32rpx;
  font-weight: 600;
}

.upload-copy {
  margin-top: 16rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.ticket-preview-wrap {
  position: relative;
  padding: 20rpx;
}

.ticket-preview {
  display: block;
  width: 100%;
  height: 480rpx;
  border-radius: 20rpx;
  background: var(--bg-sunken);
}

.replace-button {
  position: absolute;
  right: 38rpx;
  bottom: 38rpx;
  padding: 18rpx 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  border-radius: 999rpx;
  background: rgba(40, 36, 33, 0.78);
  color: #FFFFFF;
  font-size: 24rpx;
}

.privacy-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 22rpx 12rpx 34rpx;
  color: #35674F;
  font-size: 23rpx;
}

.privacy-icon {
  font-size: 30rpx;
}

.form-card {
  padding: 12rpx 32rpx;
}

.form-field {
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--border-subtle);
}

.form-field--last {
  border-bottom: 0;
}

.field-label {
  display: block;
  margin-bottom: 17rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
  font-weight: 600;
}

.field-input,
.picker-value {
  width: 100%;
  min-height: 58rpx;
  color: var(--text-primary);
  font-size: 30rpx;
  line-height: 58rpx;
}

.field-input::placeholder,
.field-textarea::placeholder {
  color: #91877C;
}

.picker-value {
  display: flex;
  justify-content: space-between;
}

.field-textarea {
  width: 100%;
  min-height: 180rpx;
  color: var(--text-primary);
  font-size: 29rpx;
  line-height: 1.65;
}

.form-grid {
  display: flex;
  gap: 26rpx;
}

.form-field--half {
  min-width: 0;
  flex: 1;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.choice-chip {
  display: inline-flex;
  min-height: 58rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border: 1rpx solid var(--border-subtle);
  border-radius: 999rpx;
  background: var(--bg-surface);
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1;
}

.choice-chip--selected {
  border-color: var(--brand-primary);
  background: var(--brand-soft);
  color: #8F3329;
  font-weight: 600;
}

.save-button {
  margin-top: 34rpx;
}
